---
// 소개(설계 1-10). 기준은 계획 5-2절, 5-4절과 docs/methodology.md 에서 옮겼다.
import Base from "../../layouts/Base.astro";
import VerdictMark from "../../components/VerdictMark.astro";
import { loadSite } from "../../lib/data";

const site = loadSite();
const sample = [...site.issues.values()].map((i) => i.latest.ai_notice).find(Boolean) ?? "";
const formulaVersions = [...new Set([...site.issues.values()].flatMap((i) => [...i.revs.values(), i.latest]).map((b) => b.trend?.formula_version).filter((v) => v !== null && v !== undefined))];
const VERDICT_ROWS = [
  { v: "확인", mean: "주장의 대상, 기간, 범위, 단위가 근거와 맞다.", need: "그 사실을 판단할 권한이 있는 제3의 기관이 확정한 판단이나 기록, 당사자가 스스로 인정한 불리한 사실(인정한 범위까지), 또는 주장이 가리키는 원자료를 직접 열어 대조한 것. 반대되는 자료도 찾아봤어야 한다." },
  { v: "일부 맞음", mean: "주장을 작은 주장으로 나눴을 때 맞는 부분과 다른 부분이 있다.", need: "작은 주장마다 같은 조건을 적용하고, 맞는 부분과 다른 부분을 근거와 함께 나눠 설명할 수 있을 때. 곁가지만 맞고 핵심이 틀리면 '사실과 다름'으로 한다." },
  { v: "사실과 다름", mean: "주장의 핵심과 함께 성립할 수 없는 근거가 있다.", need: "확정된 판단이나 기록, 또는 원자료 대조로 핵심과 어긋남을 보이고 반대 자료를 찾아봤을 때. 당사자의 부인이나 자료가 없다는 것만으로는 붙이지 않는다." },
  { v: "확인 못 함", mean: "지금 가진 근거로는 결론을 낼 수 없다. 거짓이라는 뜻이 아니다.", need: "까닭(핵심 근거를 구하지 못함, 근거끼리 어긋남, 절차가 끝나지 않음, 확인할 방법이 없음)과 찾아본 범위, 무엇이 나오면 판정할 수 있는지를 함께 적는다." },
];
---
<Base title="소개">
  <h1>소개</h1>
  <p class="intro">OZL 은 그날 여러 곳에서 함께 오르내리는 이슈를 골라, 떠도는 주장마다 판정과 근거를 붙이고, 이슈가 끝날 때까지 같은 주소에서 고쳐 쓰는 이슈 기록이다.</p>

  <section class="section" aria-labelledby="principles">
    <h2 id="principles">편집 원칙</h2>
    <ul class="rows">
      <li>사람이 아니라 주장을 판정한다. 평가와 전망은 판정하지 않고 "누가 뭐라고 하나"에 의견으로 둔다.</li>
      <li>다루는 이유를 한 문장으로 쓸 수 있어야 싣는다.</li>
      <li>공개 기준: 일반인을 알아볼 수 있는 정보, 사생활, 문서 근거가 없는 범죄 의혹, 선거 판세는 싣지 않는다. 그 때문에 싣지 않은 주장이 있으면 "이 밖에 다루지 않은 주장 n건"으로 수만 적고 내용은 적지 않는다.</li>
      <li>당사자가 공개한 입장을 찾아 적는다. 없으면 "당사자의 직접 발표를 찾지 못함"과 확인 시각을 적는다.</li>
      <li>사실 문장과 해석 문장을 나눠 표시한다. 기사 문장을 옮기지 않고 매체 이름과 링크만 쓴다.</li>
      <li>내용이 바뀌면 판 번호를 올린다. 지난 판은 고정 주소로 남기고 지우지 않는다.</li>
      <li>틀리면 고치고, 고친 것을 이슈 맨 위에 고정하고, 정정 목록에 남긴다.</li>
    </ul>
  </section>

  <section class="section" aria-labelledby="verdicts">
    <h2 id="verdicts">판정 기준</h2>
    <table class="vtable">
      <thead><tr><th scope="col">판정</th><th scope="col">뜻</th><th scope="col">무엇이 있어야 붙이나</th></tr></thead>
      <tbody>
        {VERDICT_ROWS.map((r) => <tr><th scope="row"><VerdictMark verdict={r.v} size="md" /></th><td data-h="뜻">{r.mean}</td><td data-h="무엇이 있어야 붙이나">{r.need}</td></tr>)}
      </tbody>
    </table>
    <h3>근거의 종류</h3>
    <ul class="rows">
      <li><strong>공식 원문</strong>: 정부, 지자체, 회사가 직접 낸 발표문과 공시. 그렇게 발표했다는 것까지 확인된다.</li>
      <li><strong>기관 자료</strong>: 통계, 감사 보고서, 판결처럼 권한 있는 기관이 낸 기록. 판결은 그 심급의 판단이고, 확정됐는지는 따로 본다.</li>
      <li><strong>보도</strong>: 기사. 보도만으로는 '확인'을 붙이지 않는다. 기사가 공개한 원자료를 직접 열 수 있으면 그 자료를 근거로 쓴다.</li>
    </ul>
  </section>

  <section class="section" aria-labelledby="score">
    <h2 id="score">화제 점수 계산법</h2>
    <p>화제 점수는 관심의 크기이고, 사실인지나 중요한지를 뜻하지 않는다.</p>
    <p class="gap">점수는 0에서 100 사이다. 첫 판으로 정한 식은 아래와 같고, 처음 30일은 비중을 바꾸지 않는다. 식을 바꾸면 판 번호를 올리고 점수 옆 기준 시각과 함께 남긴다.{formulaVersions.length > 0 && <> 지금 화면의 점수는 식 {formulaVersions.join(", ")}판으로 낸 값이다.</>}</p>
    <h3>재료</h3>
    <ul class="rows">
      <li><strong>매체 수</strong>: 그날 그 이슈를 다룬 서로 다른 언론사 수. 같은 기사를 옮겨 실은 것은 원래 기사 하나로 센다.</li>
      <li><strong>검색</strong>: 관련 검색어가 그날 급상승 검색어에 올랐는지와 그 등급.</li>
      <li><strong>위키백과</strong>: 관련 문서가 그날 조회 상위 300위 안에 들었는지와 그 순위.</li>
    </ul>
    <h3>합치는 법</h3>
    <ol class="steps">
      <li>오늘 크기: 매체 수(로그로 눌러 30곳에서 꽉 찬다) 60%, 검색 25%, 위키백과 15%를 더한다.</li>
      <li>쌓인 열기: 어제의 쌓인 열기에 0.7을 곱하고 오늘 크기를 더한다. 며칠 이어진 이슈가 하루 반짝한 이슈보다 높게 나온다.</li>
      <li>함께 나타남: 언론, 검색, 위키백과, 공공 기관 발표 가운데 몇 종류에 함께 나왔는지.</li>
      <li>며칠째: 오늘 크기가 0.1 이상인 날 수(7일에서 꽉 찬다).</li>
      <li>번짐: 서로 다른 매체 세 곳 이상이 다룬 새 사건과 새로 등장한 인물, 기관의 수.</li>
      <li>화제 점수 = 100 × (쌓인 열기 40% + 함께 나타남 25% + 며칠째 15% + 번짐 20%). 반올림한다.</li>
    </ol>
    <p class="gap">순위가 아니라 이 절대 척도를 쓴다. 조용한 날의 1위와 큰 사건이 난 날의 1위가 같은 점수가 되지 않게 하려는 것이다. 어떤 종류의 수집이 그날 실패하면 그 몫을 나머지에 나눠 준다(첫 화면의 "출처 n종 기준"이 그날 쓴 출처의 수다). 기준 시각은 점수를 계산한 시각이고, 이슈 화면의 판에는 그 판을 승인할 때의 점수와 기준 시각을 고정한다.</p>
    <h3>7일 막대</h3>
    <p>막대는 최근 7일의 날마다 화제 크기를, 그 7일 가운데 가장 큰 날을 100으로 두고 견준 값이다. 막대 위 숫자가 그 값이고, 0인 날은 막대 없이 "없음"으로 적는다.</p>
  </section>

  <section class="section" aria-labelledby="auto-human">
    <h2 id="auto-human">자동이 하는 일과 사람이 하는 일</h2>
    <table class="two">
      <thead><tr><th scope="col">자동(프로그램과 AI 도구)</th><th scope="col">사람</th></tr></thead>
      <tbody>
        <tr>
          <td><ul class="dots"><li>수집</li><li>같은 이슈 묶기</li><li>화제 점수 계산</li><li>조사와 판정 초안(AI 도구)</li><li>원문 대조</li><li>형식과 문체 검사</li></ul></td>
          <td><ul class="dots"><li>다룰 이슈 고르기</li><li>게시 승인</li></ul></td>
        </tr>
      </tbody>
    </table>
    <p class="small muted gap">조사와 판정 초안, 원문 대조, 검토에 언어 모델을 쓴다. 검토는 초안을 쓴 모델과 다른 모델이 한다.</p>
  </section>

  <section class="section" aria-labelledby="ai">
    <h2 id="ai">AI 사용 고지</h2>
    {sample ? <p>이슈마다 끝에 그 판을 누가 만들고 승인했는지 적는다. 예: "{sample}"</p>
      : <p>이슈마다 끝에 그 판을 누가 만들고 승인했는지 적는다.</p>}
  </section>
</Base>
<style>
  .intro { margin-top: var(--sp-3); }
  .gap { margin-top: var(--sp-3); }
  table { width: 100%; font-size: var(--fs-sm); }
  th, td { text-align: left; vertical-align: top; padding: var(--sp-3) var(--sp-2) var(--sp-3) 0; border-top: 1px solid var(--rule); }
  thead th { font-weight: 700; color: var(--muted); }
  .dots li { padding: 2px 0; }
  .steps { list-style: decimal; padding-left: 1.4em; }
  .steps li { padding: var(--sp-1) 0; }
  .dots li::before { content: "– "; color: var(--muted); }
  @media (max-width: 767px) {
    .vtable thead { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
    .vtable tr, .vtable th, .vtable td { display: block; }
    .vtable tr { border-top: 1px solid var(--rule); padding: var(--sp-3) 0; }
    .vtable th, .vtable td { border: 0; padding: var(--sp-1) 0; }
    .vtable td::before { content: attr(data-h); display: block; font-weight: 700; color: var(--muted); font-size: var(--fs-xs); }
  }
</style>
