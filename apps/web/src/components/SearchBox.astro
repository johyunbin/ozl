---
// 검색 입력(설계 4-15). pagefind.js 는 입력이 있을 때만 불러온다.
import { BASE, url } from "../lib/paths";
---
<form action={url("search/")} method="get" role="search" class="search-box" data-base={BASE}>
  <label for="q">찾을 말</label>
  <div class="field">
    <input id="q" type="search" name="q" autocomplete="off" />
    <button type="submit">찾기</button>
  </div>
</form>
<style>
  .search-box { margin-top: var(--sp-4); }
  label { display: block; font-size: var(--fs-sm); margin-bottom: var(--sp-1); }
  .field { display: flex; gap: var(--sp-2); }
  input { flex: 1; min-width: 0; height: 48px; font-size: var(--fs-md); padding: 0 var(--sp-3); background: var(--bg); color: var(--text); border: 1px solid var(--rule-strong); border-radius: 2px; }
  button { height: 48px; min-width: 64px; padding: 0 var(--sp-4); background: var(--accent); color: var(--bg); border: 1px solid var(--accent); border-radius: 2px; font-weight: 600; cursor: pointer; }
</style>
